{
	"name": "n8n-nodes-falcon",
	"version": "0.1.146",
	"description": "N8N community node for CrowdStrike Falcon API",
	"license": "MIT",
	"homepage": "https://github.com/cpadlab/n8n-nodes-falcon.git",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Carlos Padilla",
		"email": "cpadlab@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cpadlab/n8n-nodes-falcon.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/CrowdStrikeFalconApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CrowdStrikeFalcon/CrowdStrikeFalcon.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.41.2",
		"@sonar/scan": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.1.2",
		"eslint": "^8.57.1",
		"jest": "^30.4.2",
		"n8n-workflow": "^2.16.0",
		"prettier": "3.9.6",
		"release-it": "^21.0.0",
		"ts-jest": "^29.2.5",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"crowdstrike-falcon": "^0.7.0"
	}
}
